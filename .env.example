# Website Monitoring Configuration
# Copy this file to .env and customize the values

# Target website URL to monitor
TARGET_URL=https://webpac.library.gov.mo/client/zh_TW/webpac/search/results?qu=%E9%AC%BC%E6%BB%85&te=ILS

# Discord Webhook Configuration for error alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1111111/aaaaaaaaaaaaaa

# Examples:
# TARGET_URL=https://example.com/api/health
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN